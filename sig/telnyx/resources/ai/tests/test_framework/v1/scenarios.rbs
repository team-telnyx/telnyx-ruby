                ?instructions: String,
                ?metrics: ::Array[Integer],
                ?tags: ::Array[String],
                ?test_profile: Integer,
                ?request_options: Telnyx::request_opts
              ) -> Telnyx::AI::Tests::TestFramework::V1::EvaluatorScenarioDetail

              def retrieve: (
                Integer id,
