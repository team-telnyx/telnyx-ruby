module Telnyx
  module Resources
    class LlmTokenGateway
      class Spend
        def retrieve_events: (
          ?end_date: Date,
          ?end_user_id: String,
          ?metadata: ::Hash[Symbol, String],
          ?page_number: Integer,
          ?page_size: Integer,
          ?page_snapshot: String,
          ?start_date: Date,
          ?token_group_id: String,
          ?token_key_id: String,
          ?token_user_id: String,
          ?request_options: Telnyx::request_opts
        ) -> Telnyx::Models::LlmTokenGateway::SpendRetrieveEventsResponse

        def retrieve_summary: (
          end_date: Date,
          group_by: Telnyx::Models::LlmTokenGateway::spend_group_by,
          start_date: Date,
          ?end_user_id: String,
          ?metadata: ::Hash[Symbol, String],
          ?page_number: Integer,
          ?page_size: Integer,
          ?page_snapshot: String,
          ?token_group_id: String,
          ?token_key_id: String,
          ?token_user_id: String,
          ?request_options: Telnyx::request_opts
        ) -> Telnyx::Models::LlmTokenGateway::SpendRetrieveSummaryResponse

        def initialize: (client: Telnyx::Client) -> void
      end
    end
  end
end
