module Telnyx
  module Resources
    class FqdnConnections
      class FqdnAuthentication
        def list: (
          String fqdn_connection_id,
          ?request_options: Telnyx::request_opts
        ) -> Telnyx::Models::FqdnConnections::FqdnAuthenticationListResponse

        def patch_all: (
          String fqdn_connection_id,
          ?failover_url: String,
