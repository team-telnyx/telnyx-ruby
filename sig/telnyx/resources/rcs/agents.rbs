module Telnyx
  module Resources
    class Rcs
      class Agents
        attr_reader test_devices: Telnyx::Resources::Rcs::Agents::TestDevices

        def create: (
          brand_id: String,
          configuration: Telnyx::Rcs::AgentConfiguration,
          display_name: String,
          use_case: Telnyx::Models::Rcs::agent_use_case,
          idempotency_key: String,
          ?hosting_region: String?,
          ?profile_id: String?,
          ?request_options: Telnyx::request_opts
        ) -> Telnyx::Rcs::AgentResponse

        def retrieve: (
          String id,
          ?request_options: Telnyx::request_opts
        ) -> Telnyx::Rcs::AgentResponse

        def update: (
          String id,
          ?configuration: Telnyx::Rcs::AgentConfiguration,
          ?display_name: String,
          ?hosting_region: String,
          ?profile_id: String,
          ?use_case: Telnyx::Models::Rcs::agent_use_case,
          ?request_options: Telnyx::request_opts
        ) -> Telnyx::Rcs::AgentResponse

        def list: (
          ?brand_id: String,
          ?request_options: Telnyx::request_opts
        ) -> Telnyx::Models::Rcs::agent_list_response

        def launch: (
          String id,
          campaign: Telnyx::Rcs::AgentLaunchParams::Campaign,
          testing: Telnyx::Rcs::AgentTestingConfiguration,
          ?request_options: Telnyx::request_opts
        ) -> Telnyx::Rcs::AgentResponse

        def retrieve_carrier_approvals: (
          String id,
          ?request_options: Telnyx::request_opts
        ) -> Telnyx::Models::Rcs::agent_retrieve_carrier_approvals_response

        def submit: (
          String id,
          ?request_options: Telnyx::request_opts
        ) -> Telnyx::Rcs::AgentResponse

        def initialize: (client: Telnyx::Client) -> void
      end
    end
  end
end
