module Telnyx
  module Resources
    class EmailUnsubscribeGroups
      class Suppressions
        def create: (
          String id,
          to: String,
          ?request_options: Telnyx::request_opts
        ) -> Telnyx::EmailBlockResponse

        def list: (
          String id,
          ?page_number: Integer,
          ?page_size: Integer,
          ?request_options: Telnyx::request_opts
        ) -> Telnyx::Internal::DefaultFlatPagination[Telnyx::EmailBlock]

        def delete: (
          String email,
          id: String,
          ?request_options: Telnyx::request_opts
        ) -> nil

        def initialize: (client: Telnyx::Client) -> void
      end
