module Telnyx
  module Models
    module TtsIntegrations
      type action_test_connection_params =
        { id: String, api_key_ref: String, voice_id: String }
        & Telnyx::Internal::Type::request_parameters

      class ActionTestConnectionParams < Telnyx::Internal::Type::BaseModel
        extend Telnyx::Internal::Type::RequestParameters::Converter
        include Telnyx::Internal::Type::RequestParameters

        attr_accessor id: String

        attr_accessor api_key_ref: String

        attr_reader voice_id: String?

        def voice_id=: (String) -> String

        def initialize: (
          id: String,
          api_key_ref: String,
          ?voice_id: String,
          ?request_options: Telnyx::request_opts
        ) -> void

        def to_hash: -> {
          id: String,
          api_key_ref: String,
          voice_id: String,
          request_options: Telnyx::RequestOptions
        }
      end
    end
  end
end
