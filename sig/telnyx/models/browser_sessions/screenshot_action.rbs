module Telnyx
  module Models
    module BrowserSessions
      type screenshot_action =
        {
          type: :screenshot,
          idempotency_key: String,
          include_observation: bool
        }

      class ScreenshotAction < Telnyx::Internal::Type::BaseModel
        attr_accessor type: :screenshot

        attr_reader idempotency_key: String?

        def idempotency_key=: (String) -> String

        attr_reader include_observation: bool?

        def include_observation=: (bool) -> bool

        def initialize: (
          ?idempotency_key: String,
          ?include_observation: bool,
          ?type: :screenshot
        ) -> void

        def to_hash: -> {
          type: :screenshot,
          idempotency_key: String,
          include_observation: bool
        }
      end
    end
  end
end
