module Telnyx
  module Models
    module BrowserSessions
      type navigate_action =
        {
          type: :navigate,
          url: String,
          idempotency_key: String,
          include_observation: bool,
          wait_until: Telnyx::Models::BrowserSessions::NavigateAction::wait_until
        }

      class NavigateAction < Telnyx::Internal::Type::BaseModel
        attr_accessor type: :navigate

        attr_accessor url: String

        attr_reader idempotency_key: String?

        def idempotency_key=: (String) -> String

        attr_reader include_observation: bool?

        def include_observation=: (bool) -> bool

        attr_reader wait_until: Telnyx::Models::BrowserSessions::NavigateAction::wait_until?

        def wait_until=: (
          Telnyx::Models::BrowserSessions::NavigateAction::wait_until
        ) -> Telnyx::Models::BrowserSessions::NavigateAction::wait_until

        def initialize: (
          url: String,
          ?idempotency_key: String,
          ?include_observation: bool,
          ?wait_until: Telnyx::Models::BrowserSessions::NavigateAction::wait_until,
          ?type: :navigate
        ) -> void

        def to_hash: -> {
          type: :navigate,
          url: String,
          idempotency_key: String,
          include_observation: bool,
          wait_until: Telnyx::Models::BrowserSessions::NavigateAction::wait_until
        }

        type wait_until = :load | :dom_stable | :none

        module WaitUntil
          extend Telnyx::Internal::Type::Enum

          LOAD: :load
          DOM_STABLE: :dom_stable
          NONE: :none

          def self?.values: -> ::Array[Telnyx::Models::BrowserSessions::NavigateAction::wait_until]
        end
      end
    end
  end
end
