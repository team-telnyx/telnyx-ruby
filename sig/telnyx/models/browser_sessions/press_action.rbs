module Telnyx
  module Models
    module BrowserSessions
      type press_action =
        {
          key: Telnyx::Models::BrowserSessions::PressAction::key,
          type: :press,
          idempotency_key: String,
          include_observation: bool
        }

      class PressAction < Telnyx::Internal::Type::BaseModel
        attr_accessor key: Telnyx::Models::BrowserSessions::PressAction::key

        attr_accessor type: :press

        attr_reader idempotency_key: String?

        def idempotency_key=: (String) -> String

        attr_reader include_observation: bool?

        def include_observation=: (bool) -> bool

        def initialize: (
          key: Telnyx::Models::BrowserSessions::PressAction::key,
          ?idempotency_key: String,
          ?include_observation: bool,
          ?type: :press
        ) -> void

        def to_hash: -> {
          key: Telnyx::Models::BrowserSessions::PressAction::key,
          type: :press,
          idempotency_key: String,
          include_observation: bool
        }

        type key =
          :Enter
          | :Tab
          | :Escape
          | :Backspace
          | :ArrowUp
          | :ArrowDown
          | :ArrowLeft
          | :ArrowRight
          | :PageUp
          | :PageDown
          | :Home
          | :End

        module Key
          extend Telnyx::Internal::Type::Enum

          ENTER: :Enter
          TAB: :Tab
          ESCAPE: :Escape
          BACKSPACE: :Backspace
          ARROW_UP: :ArrowUp
          ARROW_DOWN: :ArrowDown
          ARROW_LEFT: :ArrowLeft
          ARROW_RIGHT: :ArrowRight
          PAGE_UP: :PageUp
          PAGE_DOWN: :PageDown
          HOME: :Home
          END_: :End

          def self?.values: -> ::Array[Telnyx::Models::BrowserSessions::PressAction::key]
        end
      end
    end
  end
end
