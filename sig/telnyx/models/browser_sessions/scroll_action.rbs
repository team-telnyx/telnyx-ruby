module Telnyx
  module Models
    module BrowserSessions
      type scroll_action =
        {
          type: :scroll,
          delta_x: Integer,
          delta_y: Integer,
          idempotency_key: String,
          include_observation: bool
        }

      class ScrollAction < Telnyx::Internal::Type::BaseModel
        attr_accessor type: :scroll

        attr_reader delta_x: Integer?

        def delta_x=: (Integer) -> Integer

        attr_reader delta_y: Integer?

        def delta_y=: (Integer) -> Integer

        attr_reader idempotency_key: String?

        def idempotency_key=: (String) -> String

        attr_reader include_observation: bool?

        def include_observation=: (bool) -> bool

        def initialize: (
          ?delta_x: Integer,
          ?delta_y: Integer,
          ?idempotency_key: String,
          ?include_observation: bool,
          ?type: :scroll
        ) -> void

        def to_hash: -> {
          type: :scroll,
          delta_x: Integer,
          delta_y: Integer,
          idempotency_key: String,
          include_observation: bool
        }
      end
    end
  end
end
