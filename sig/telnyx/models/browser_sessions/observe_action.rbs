module Telnyx
  module Models
    module BrowserSessions
      type observe_action =
        { type: :observe, idempotency_key: String, include_observation: bool }

      class ObserveAction < Telnyx::Internal::Type::BaseModel
        attr_accessor type: :observe

        attr_reader idempotency_key: String?

        def idempotency_key=: (String) -> String

        attr_reader include_observation: bool?

        def include_observation=: (bool) -> bool

        def initialize: (
          ?idempotency_key: String,
          ?include_observation: bool,
          ?type: :observe
        ) -> void

        def to_hash: -> {
          type: :observe,
          idempotency_key: String,
          include_observation: bool
        }
      end
    end
  end
end
