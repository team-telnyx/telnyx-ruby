          ACTIVE: :active
          LEAVING: :leaving
          ENDED: :ended
          FAILED: :failed
          ADMISSION_DENIED: :admission_denied

          def self?.values: -> ::Array[Telnyx::Models::SessionStatusChangedWebhookEvent::Data::previous_status]
