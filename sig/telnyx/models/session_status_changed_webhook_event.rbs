      end

      type event = :"session.status_changed"

      module Event
        extend Telnyx::Internal::Type::Enum

        SESSION_STATUS_CHANGED: :"session.status_changed"

        def self?.values: -> ::Array[Telnyx::Models::SessionStatusChangedWebhookEvent::event]
