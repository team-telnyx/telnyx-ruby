        ) -> Telnyx::Models::EmailEventListResponse::Payload::cc

        attr_reader from: Telnyx::Models::EmailEventListResponse::Payload::From?

        def from=: (
          Telnyx::Models::EmailEventListResponse::Payload::From
        ) -> Telnyx::Models::EmailEventListResponse::Payload::From

        attr_reader recipient_id: String?

        def recipient_id=: (String) -> String

        attr_reader subject: String?

