        canonical_event_type: String,
        event_type: String,
        occurred_at: Time,
        payload: Telnyx::Models::EmailEventListResponse::Payload,
        recipient_id: String
      }

    class EmailEventListResponse < Telnyx::Internal::Type::BaseModel
