          status: Telnyx::Models::EmailEventListResponse::Payload::status,
          bcc: Telnyx::Models::EmailEventListResponse::Payload::bcc,
          cc: Telnyx::Models::EmailEventListResponse::Payload::cc,
          from: Telnyx::Models::EmailEventListResponse::Payload::From,
