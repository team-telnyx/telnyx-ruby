          cc: Telnyx::Models::EmailEventListResponse::Payload::cc,
          from: Telnyx::Models::EmailEventListResponse::Payload::From,
          recipient_id: String,
          subject: String,
          to: Telnyx::Models::EmailEventListResponse::Payload::to
        }

      class Payload < Telnyx::Internal::Type::BaseModel
