          subject: String,
          to: Telnyx::Models::EmailEventListResponse::Payload::to
        }

        type status =
          :queued
          | :deferred
          | :scheduled
          | :cancelled
          | :sandbox
          | :sending
          | :sent
          | :failed
          | :delivered
          | :bounced
          | :complained
          | :suppressed
