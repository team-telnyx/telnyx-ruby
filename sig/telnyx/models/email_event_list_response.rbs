          SCHEDULED: :scheduled
          CANCELLED: :cancelled
          SANDBOX: :sandbox
          SENDING: :sending
          SENT: :sent
          FAILED: :failed
          DELIVERED: :delivered
          BOUNCED: :bounced
          COMPLAINED: :complained
          SUPPRESSED: :suppressed
          REJECTED: :rejected
          OPENED: :opened
