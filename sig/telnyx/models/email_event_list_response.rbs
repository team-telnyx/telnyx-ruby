          EXPIRED: :expired

          def self?.values: -> ::Array[Telnyx::Models::EmailEventListResponse::Payload::status]
        end

        type bcc = Telnyx::EmailWebhookRecipient | :redacted

        module Bcc
          extend Telnyx::Internal::Type::Union

          def self?.variants: -> ::Array[Telnyx::Models::EmailEventListResponse::Payload::bcc]

