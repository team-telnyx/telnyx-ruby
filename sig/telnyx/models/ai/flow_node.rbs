module Telnyx
  module Models
    module AI
      type flow_node =
        {
          id: String,
          instructions: String,
          external_llm: Telnyx::AI::ExternalLlm,
          instructions_mode: Telnyx::Models::AI::FlowNode::instructions_mode,
          llm_api_key_ref: String,
          model: String,
          name: String,
          position: Telnyx::AI::NodePosition,
          shared_tool_ids: ::Array[String],
          tools: ::Array[::Array[Telnyx::Models::AI::assistant_tool]],
          tools_mode: Telnyx::Models::AI::FlowNode::tools_mode,
          transcription: Telnyx::AI::TranscriptionSettings,
          type: Telnyx::Models::AI::FlowNode::type_,
          voice_settings: Telnyx::AI::VoiceSettings
        }

      class FlowNode < Telnyx::Internal::Type::BaseModel
        attr_accessor id: String

        attr_accessor instructions: String

        attr_reader external_llm: Telnyx::AI::ExternalLlm?

        def external_llm=: (Telnyx::AI::ExternalLlm) -> Telnyx::AI::ExternalLlm

        attr_reader instructions_mode: Telnyx::Models::AI::FlowNode::instructions_mode?

        def instructions_mode=: (
          Telnyx::Models::AI::FlowNode::instructions_mode
        ) -> Telnyx::Models::AI::FlowNode::instructions_mode

        attr_reader llm_api_key_ref: String?

        def llm_api_key_ref=: (String) -> String

        attr_reader model: String?

        def model=: (String) -> String

        attr_reader name: String?

        def name=: (String) -> String

        attr_reader position: Telnyx::AI::NodePosition?

        def position=: (Telnyx::AI::NodePosition) -> Telnyx::AI::NodePosition

        attr_reader shared_tool_ids: ::Array[String]?

        def shared_tool_ids=: (::Array[String]) -> ::Array[String]

        attr_reader tools: ::Array[::Array[Telnyx::Models::AI::assistant_tool]]?

        def tools=: (
          ::Array[::Array[Telnyx::Models::AI::assistant_tool]]
        ) -> ::Array[::Array[Telnyx::Models::AI::assistant_tool]]

        attr_reader tools_mode: Telnyx::Models::AI::FlowNode::tools_mode?

        def tools_mode=: (
          Telnyx::Models::AI::FlowNode::tools_mode
        ) -> Telnyx::Models::AI::FlowNode::tools_mode

        attr_reader transcription: Telnyx::AI::TranscriptionSettings?

        def transcription=: (
          Telnyx::AI::TranscriptionSettings
        ) -> Telnyx::AI::TranscriptionSettings

        attr_reader type: Telnyx::Models::AI::FlowNode::type_?

        def type=: (
          Telnyx::Models::AI::FlowNode::type_
        ) -> Telnyx::Models::AI::FlowNode::type_

        attr_reader voice_settings: Telnyx::AI::VoiceSettings?

        def voice_settings=: (
          Telnyx::AI::VoiceSettings
        ) -> Telnyx::AI::VoiceSettings

        def initialize: (
          id: String,
          instructions: String,
          ?external_llm: Telnyx::AI::ExternalLlm,
          ?instructions_mode: Telnyx::Models::AI::FlowNode::instructions_mode,
          ?llm_api_key_ref: String,
          ?model: String,
          ?name: String,
          ?position: Telnyx::AI::NodePosition,
          ?shared_tool_ids: ::Array[String],
          ?tools: ::Array[::Array[Telnyx::Models::AI::assistant_tool]],
          ?tools_mode: Telnyx::Models::AI::FlowNode::tools_mode,
          ?transcription: Telnyx::AI::TranscriptionSettings,
          ?type: Telnyx::Models::AI::FlowNode::type_,
          ?voice_settings: Telnyx::AI::VoiceSettings
        ) -> void

        def to_hash: -> {
          id: String,
          instructions: String,
          external_llm: Telnyx::AI::ExternalLlm,
          instructions_mode: Telnyx::Models::AI::FlowNode::instructions_mode,
          llm_api_key_ref: String,
          model: String,
          name: String,
          position: Telnyx::AI::NodePosition,
          shared_tool_ids: ::Array[String],
          tools: ::Array[::Array[Telnyx::Models::AI::assistant_tool]],
          tools_mode: Telnyx::Models::AI::FlowNode::tools_mode,
          transcription: Telnyx::AI::TranscriptionSettings,
          type: Telnyx::Models::AI::FlowNode::type_,
          voice_settings: Telnyx::AI::VoiceSettings
        }

        type instructions_mode = :replace | :append

        module InstructionsMode
          extend Telnyx::Internal::Type::Enum

          REPLACE: :replace
          APPEND: :append

          def self?.values: -> ::Array[Telnyx::Models::AI::FlowNode::instructions_mode]
        end

        type tools_mode = :replace | :append

        module ToolsMode
          extend Telnyx::Internal::Type::Enum

          REPLACE: :replace
          APPEND: :append

          def self?.values: -> ::Array[Telnyx::Models::AI::FlowNode::tools_mode]
        end

        type type_ = :prompt

        module Type
          extend Telnyx::Internal::Type::Enum

          PROMPT: :prompt

          def self?.values: -> ::Array[Telnyx::Models::AI::FlowNode::type_]
        end
      end
    end
  end
end
