          module V1
            type metric_list_params =
              { agent_id: Integer, assistant_id: String }
              & Telnyx::Internal::Type::request_parameters

            class MetricListParams < Telnyx::Internal::Type::BaseModel
              extend Telnyx::Internal::Type::RequestParameters::Converter
              include Telnyx::Internal::Type::RequestParameters

              attr_reader agent_id: Integer?

              def agent_id=: (Integer) -> Integer

              attr_reader assistant_id: String?

              def assistant_id=: (String) -> String

              def initialize: (
                ?agent_id: Integer,
                ?assistant_id: String,
                ?request_options: Telnyx::request_opts
              ) -> void

              def to_hash: -> {
                agent_id: Integer,
                assistant_id: String,
                request_options: Telnyx::RequestOptions
              }
            end
          end
