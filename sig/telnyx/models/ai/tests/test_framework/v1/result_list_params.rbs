module Telnyx
  module Models
    module AI
      module Tests
        module TestFramework
          module V1
            type result_list_params =
              {
                agent_id: Integer,
                page: Integer,
                page_size: Integer,
                scenarios: String,
                search: String
              }
              & Telnyx::Internal::Type::request_parameters

            class ResultListParams < Telnyx::Internal::Type::BaseModel
              extend Telnyx::Internal::Type::RequestParameters::Converter
              include Telnyx::Internal::Type::RequestParameters

              attr_reader agent_id: Integer?

              def agent_id=: (Integer) -> Integer

              attr_reader page: Integer?

              def page=: (Integer) -> Integer

              attr_reader page_size: Integer?

              def page_size=: (Integer) -> Integer

              attr_reader scenarios: String?

              def scenarios=: (String) -> String

              attr_reader search: String?

              def search=: (String) -> String

              def initialize: (
                ?agent_id: Integer,
                ?page: Integer,
                ?page_size: Integer,
                ?scenarios: String,
                ?search: String,
                ?request_options: Telnyx::request_opts
              ) -> void

              def to_hash: -> {
                agent_id: Integer,
                page: Integer,
                page_size: Integer,
                scenarios: String,
                search: String,
                request_options: Telnyx::RequestOptions
              }
            end
          end
        end
      end
    end
  end
end
