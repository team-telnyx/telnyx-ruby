module Telnyx
  module Models
    module AI
      module Tests
        module TestFramework
          module V1
            type scenario_generate_bg_params =
              {
                num_scenarios: Integer,
                agent_id: Integer,
                extra_instructions: String,
                first_message: String,
                folder_path: String?,
                generate_expected_outcomes: bool,
                inbound_phone_number: Integer?,
                personalities: ::Array[Integer],
                scenario_type: Telnyx::Models::AI::Tests::TestFramework::V1::ScenarioGenerateBgParams::scenario_type,
                tags: ::Array[String],
                test_profile: Integer,
                tool_ids: ::Array[String]
              }
              & Telnyx::Internal::Type::request_parameters

            class ScenarioGenerateBgParams < Telnyx::Internal::Type::BaseModel
              extend Telnyx::Internal::Type::RequestParameters::Converter
              include Telnyx::Internal::Type::RequestParameters

              attr_accessor num_scenarios: Integer

              attr_reader agent_id: Integer?

              def agent_id=: (Integer) -> Integer

              attr_reader extra_instructions: String?

              def extra_instructions=: (String) -> String

              attr_reader first_message: String?

              def first_message=: (String) -> String

              attr_accessor folder_path: String?

              attr_reader generate_expected_outcomes: bool?

              def generate_expected_outcomes=: (bool) -> bool

              attr_accessor inbound_phone_number: Integer?

              attr_reader personalities: ::Array[Integer]?

              def personalities=: (::Array[Integer]) -> ::Array[Integer]

              attr_reader scenario_type: Telnyx::Models::AI::Tests::TestFramework::V1::ScenarioGenerateBgParams::scenario_type?

              def scenario_type=: (
                Telnyx::Models::AI::Tests::TestFramework::V1::ScenarioGenerateBgParams::scenario_type
              ) -> Telnyx::Models::AI::Tests::TestFramework::V1::ScenarioGenerateBgParams::scenario_type

              attr_reader tags: ::Array[String]?

              def tags=: (::Array[String]) -> ::Array[String]

              attr_reader test_profile: Integer?

              def test_profile=: (Integer) -> Integer

              attr_reader tool_ids: ::Array[String]?

              def tool_ids=: (::Array[String]) -> ::Array[String]

              def initialize: (
                num_scenarios: Integer,
                ?agent_id: Integer,
                ?extra_instructions: String,
                ?first_message: String,
                ?folder_path: String?,
                ?generate_expected_outcomes: bool,
                ?inbound_phone_number: Integer?,
                ?personalities: ::Array[Integer],
                ?scenario_type: Telnyx::Models::AI::Tests::TestFramework::V1::ScenarioGenerateBgParams::scenario_type,
                ?tags: ::Array[String],
                ?test_profile: Integer,
                ?tool_ids: ::Array[String],
                ?request_options: Telnyx::request_opts
              ) -> void

              def to_hash: -> {
                num_scenarios: Integer,
                agent_id: Integer,
                extra_instructions: String,
                first_message: String,
                folder_path: String?,
                generate_expected_outcomes: bool,
                inbound_phone_number: Integer?,
                personalities: ::Array[Integer],
                scenario_type: Telnyx::Models::AI::Tests::TestFramework::V1::ScenarioGenerateBgParams::scenario_type,
                tags: ::Array[String],
                test_profile: Integer,
                tool_ids: ::Array[String],
                request_options: Telnyx::RequestOptions
              }

              type scenario_type =
                :workflow | :red_teaming_voice | :red_teaming_text

              module ScenarioType
                extend Telnyx::Internal::Type::Enum

                WORKFLOW: :workflow
                RED_TEAMING_VOICE: :red_teaming_voice
                RED_TEAMING_TEXT: :red_teaming_text

                def self?.values: -> ::Array[Telnyx::Models::AI::Tests::TestFramework::V1::ScenarioGenerateBgParams::scenario_type]
              end
            end
          end
        end
      end
    end
  end
end
