                Telnyx::Models::AI::Tests::TestFramework::V1::AITestMetric::overall_score
              ) -> Telnyx::Models::AI::Tests::TestFramework::V1::AITestMetric::overall_score

              attr_reader priority_assignment_prompt: String?

              def priority_assignment_prompt=: (String) -> String

              attr_accessor project: Integer?

