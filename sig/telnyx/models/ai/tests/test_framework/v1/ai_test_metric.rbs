          module V1
            type ai_test_metric =
              {
                id: Integer,
                eval_type: String,
                name: String,
                type: String,
                add_to_new_agents: bool?,
                agent: Integer?,
                agent_names: ::Array[String],
                agents: ::Array[Integer],
                alert_filters: ::Hash[Symbol, top]?,
                alert_type: String,
                audio_enabled: bool,
                configuration: ::Hash[Symbol, top]?,
                description: String,
                display_order: Integer,
                enum_values: ::Array[String],
