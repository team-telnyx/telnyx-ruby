module Telnyx
  module Models
    module AI
      module Tests
        module TestFramework
          module V1
            type scenario_list_params =
              {
                agent_id: Integer,
                assistant_id: String,
                page: Integer,
                page_size: Integer,
                tags: String
              }
              & Telnyx::Internal::Type::request_parameters

            class ScenarioListParams < Telnyx::Internal::Type::BaseModel
              extend Telnyx::Internal::Type::RequestParameters::Converter
              include Telnyx::Internal::Type::RequestParameters

              attr_reader agent_id: Integer?

              def agent_id=: (Integer) -> Integer

              attr_reader assistant_id: String?

              def assistant_id=: (String) -> String

              attr_reader page: Integer?

              def page=: (Integer) -> Integer

              attr_reader page_size: Integer?

              def page_size=: (Integer) -> Integer

              attr_reader tags: String?

              def tags=: (String) -> String

              def initialize: (
                ?agent_id: Integer,
                ?assistant_id: String,
                ?page: Integer,
                ?page_size: Integer,
                ?tags: String,
                ?request_options: Telnyx::request_opts
              ) -> void

              def to_hash: -> {
                agent_id: Integer,
                assistant_id: String,
                page: Integer,
                page_size: Integer,
                tags: String,
                request_options: Telnyx::RequestOptions
              }
            end
          end
        end
      end
    end
  end
