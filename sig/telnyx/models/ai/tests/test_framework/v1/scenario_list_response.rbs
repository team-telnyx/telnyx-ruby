module Telnyx
  module Models
    module AI
      module Tests
        module TestFramework
          module V1
            type scenario_list_response =
              {
                count: Integer,
                next_: String?,
                previous: String?,
                results: ::Array[Telnyx::Models::AI::Tests::TestFramework::V1::ScenarioListResponse::Result]
              }

            class ScenarioListResponse < Telnyx::Internal::Type::BaseModel
              attr_accessor count: Integer

              attr_accessor next_: String?

              attr_accessor previous: String?

              attr_accessor results: ::Array[Telnyx::Models::AI::Tests::TestFramework::V1::ScenarioListResponse::Result]

              def initialize: (
                count: Integer,
                next_: String?,
                previous: String?,
                results: ::Array[Telnyx::Models::AI::Tests::TestFramework::V1::ScenarioListResponse::Result]
              ) -> void

              def to_hash: -> {
                count: Integer,
                next_: String?,
                previous: String?,
                results: ::Array[Telnyx::Models::AI::Tests::TestFramework::V1::ScenarioListResponse::Result]
              }

              type result =
                {
                  id: Integer,
                  agent: Integer?,
                  created_at: Time,
                  name: String,
                  updated_at: Time,
                  dynamic_variable_values: ::Hash[Symbol, String]?,
                  expected_outcome_prompt: String,
                  first_message: String,
                  folder_path: String?,
                  inbound_phone_number: Integer?,
                  inbound_phone_number_data: String?,
                  instructions: String,
                  last_updated_by: Integer?,
                  metric_names: ::Array[String],
                  metrics: ::Array[Integer],
                  personality: Integer?,
                  personality_name: String,
                  phone_number: String,
                  scenario_language: String?,
                  scenario_type: String,
                  tags: ::Array[String],
                  test_profile: Integer?,
                  test_profile_data: Telnyx::Models::AI::Tests::TestFramework::V1::ScenarioListResponse::Result::TestProfileData?,
                  tool_ids: ::Array[String]
                }

              class Result < Telnyx::Internal::Type::BaseModel
                attr_accessor id: Integer

                attr_accessor agent: Integer?

                attr_accessor created_at: Time

                attr_accessor name: String

                attr_accessor updated_at: Time

                attr_accessor dynamic_variable_values: ::Hash[Symbol, String]?

                attr_reader expected_outcome_prompt: String?

                def expected_outcome_prompt=: (String) -> String

                attr_reader first_message: String?

                def first_message=: (String) -> String

                attr_accessor folder_path: String?

                attr_accessor inbound_phone_number: Integer?

                attr_accessor inbound_phone_number_data: String?

                attr_reader instructions: String?

                def instructions=: (String) -> String

                attr_accessor last_updated_by: Integer?

                attr_reader metric_names: ::Array[String]?

                def metric_names=: (::Array[String]) -> ::Array[String]

                attr_reader metrics: ::Array[Integer]?

                def metrics=: (::Array[Integer]) -> ::Array[Integer]

                attr_accessor personality: Integer?

                attr_reader personality_name: String?

                def personality_name=: (String) -> String

                attr_reader phone_number: String?

                def phone_number=: (String) -> String

                attr_accessor scenario_language: String?

                attr_reader scenario_type: String?

                def scenario_type=: (String) -> String

                attr_reader tags: ::Array[String]?

                def tags=: (::Array[String]) -> ::Array[String]

                attr_accessor test_profile: Integer?

                attr_accessor test_profile_data: Telnyx::Models::AI::Tests::TestFramework::V1::ScenarioListResponse::Result::TestProfileData?

                attr_reader tool_ids: ::Array[String]?

                def tool_ids=: (::Array[String]) -> ::Array[String]

                def initialize: (
                  id: Integer,
                  agent: Integer?,
                  created_at: Time,
                  name: String,
                  updated_at: Time,
                  ?dynamic_variable_values: ::Hash[Symbol, String]?,
                  ?expected_outcome_prompt: String,
                  ?first_message: String,
                  ?folder_path: String?,
                  ?inbound_phone_number: Integer?,
                  ?inbound_phone_number_data: String?,
                  ?instructions: String,
                  ?last_updated_by: Integer?,
                  ?metric_names: ::Array[String],
                  ?metrics: ::Array[Integer],
                  ?personality: Integer?,
                  ?personality_name: String,
                  ?phone_number: String,
                  ?scenario_language: String?,
                  ?scenario_type: String,
                  ?tags: ::Array[String],
                  ?test_profile: Integer?,
                  ?test_profile_data: Telnyx::Models::AI::Tests::TestFramework::V1::ScenarioListResponse::Result::TestProfileData?,
                  ?tool_ids: ::Array[String]
                ) -> void

                def to_hash: -> {
                  id: Integer,
                  agent: Integer?,
                  created_at: Time,
                  name: String,
                  updated_at: Time,
                  dynamic_variable_values: ::Hash[Symbol, String]?,
                  expected_outcome_prompt: String,
                  first_message: String,
                  folder_path: String?,
                  inbound_phone_number: Integer?,
                  inbound_phone_number_data: String?,
                  instructions: String,
                  last_updated_by: Integer?,
                  metric_names: ::Array[String],
                  metrics: ::Array[Integer],
                  personality: Integer?,
                  personality_name: String,
                  phone_number: String,
                  scenario_language: String?,
                  scenario_type: String,
                  tags: ::Array[String],
                  test_profile: Integer?,
                  test_profile_data: Telnyx::Models::AI::Tests::TestFramework::V1::ScenarioListResponse::Result::TestProfileData?,
                  tool_ids: ::Array[String]
                }

                type test_profile_data =
                  {
                    id: Integer,
                    agent: Integer?,
                    information: ::Hash[Symbol, String]?,
                    name: String,
                    project: Integer?
                  }

                class TestProfileData < Telnyx::Internal::Type::BaseModel
                  attr_reader id: Integer?

                  def id=: (Integer) -> Integer

                  attr_accessor agent: Integer?

                  attr_accessor information: ::Hash[Symbol, String]?

                  attr_reader name: String?

                  def name=: (String) -> String

                  attr_accessor project: Integer?

                  def initialize: (
                    ?id: Integer,
                    ?agent: Integer?,
                    ?information: ::Hash[Symbol, String]?,
                    ?name: String,
                    ?project: Integer?
                  ) -> void

                  def to_hash: -> {
                    id: Integer,
                    agent: Integer?,
                    information: ::Hash[Symbol, String]?,
                    name: String,
                    project: Integer?
                  }
                end
              end
            end
          end
        end
      end
    end
  end
end
