module Telnyx
  module Models
    module AI
      module Tests
        module TestFramework
          module V1
            type scenario_update_params =
              {
                id: Integer,
                agent: Integer?,
                expected_outcome_prompt: String,
                first_message: String,
                folder_path: String?,
                inbound_phone_number: Integer,
                instructions: String,
                max_duration: Integer?,
                metrics: ::Array[Integer],
                name: String,
                personality: Integer,
                phone_number: Integer,
                scenario_language: String,
                tags: ::Array[String],
                test_profile: Integer,
                tool_ids: ::Array[String]
              }
              & Telnyx::Internal::Type::request_parameters

            class ScenarioUpdateParams < Telnyx::Internal::Type::BaseModel
              extend Telnyx::Internal::Type::RequestParameters::Converter
              include Telnyx::Internal::Type::RequestParameters

              attr_accessor id: Integer

              attr_accessor agent: Integer?

              attr_reader expected_outcome_prompt: String?

              def expected_outcome_prompt=: (String) -> String

              attr_reader first_message: String?

              def first_message=: (String) -> String

              attr_accessor folder_path: String?

              attr_reader inbound_phone_number: Integer?

              def inbound_phone_number=: (Integer) -> Integer

              attr_reader instructions: String?

              def instructions=: (String) -> String

              attr_accessor max_duration: Integer?

              attr_reader metrics: ::Array[Integer]?

              def metrics=: (::Array[Integer]) -> ::Array[Integer]

              attr_reader name: String?

              def name=: (String) -> String

              attr_reader personality: Integer?

              def personality=: (Integer) -> Integer

              attr_reader phone_number: Integer?

              def phone_number=: (Integer) -> Integer

              attr_reader scenario_language: String?

              def scenario_language=: (String) -> String

              attr_reader tags: ::Array[String]?

              def tags=: (::Array[String]) -> ::Array[String]

              attr_reader test_profile: Integer?

              def test_profile=: (Integer) -> Integer

              attr_reader tool_ids: ::Array[String]?

              def tool_ids=: (::Array[String]) -> ::Array[String]

              def initialize: (
                id: Integer,
                ?agent: Integer?,
                ?expected_outcome_prompt: String,
                ?first_message: String,
                ?folder_path: String?,
                ?inbound_phone_number: Integer,
                ?instructions: String,
                ?max_duration: Integer?,
                ?metrics: ::Array[Integer],
                ?name: String,
                ?personality: Integer,
                ?phone_number: Integer,
                ?scenario_language: String,
                ?tags: ::Array[String],
                ?test_profile: Integer,
                ?tool_ids: ::Array[String],
                ?request_options: Telnyx::request_opts
              ) -> void

              def to_hash: -> {
                id: Integer,
                agent: Integer?,
                expected_outcome_prompt: String,
                first_message: String,
                folder_path: String?,
                inbound_phone_number: Integer,
                instructions: String,
                max_duration: Integer?,
                metrics: ::Array[Integer],
                name: String,
                personality: Integer,
                phone_number: Integer,
                scenario_language: String,
                tags: ::Array[String],
                test_profile: Integer,
                tool_ids: ::Array[String],
                request_options: Telnyx::RequestOptions
              }
            end
