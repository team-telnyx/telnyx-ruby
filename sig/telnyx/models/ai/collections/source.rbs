module Telnyx
  module Models
    module AI
      module Collections
        type source =
          {
            id: String,
            memory_count: Integer,
            session_id: String?,
            created_at: String?,
            updated_at: String?
          }

        class Source < Telnyx::Internal::Type::BaseModel
          attr_accessor id: String

          attr_accessor memory_count: Integer

          attr_accessor session_id: String?

          attr_accessor created_at: String?

          attr_accessor updated_at: String?

          def initialize: (
            id: String,
            memory_count: Integer,
            session_id: String?,
            ?created_at: String?,
            ?updated_at: String?
          ) -> void

          def to_hash: -> {
            id: String,
            memory_count: Integer,
            session_id: String?,
            created_at: String?,
            updated_at: String?
          }
        end
      end
    end
  end
end
