module Telnyx
  module Models
    module AI
      type delegation_settings =
        {
          enabled: bool,
          external_llm: Telnyx::AI::ExternalLlm,
          instructions: String,
          llm_api_key_ref: String,
          mode: Telnyx::Models::AI::DelegationSettings::mode,
          model: String,
          speak_results: bool
        }

      class DelegationSettings < Telnyx::Internal::Type::BaseModel
        attr_reader enabled: bool?

        def enabled=: (bool) -> bool

        attr_reader external_llm: Telnyx::AI::ExternalLlm?

        def external_llm=: (Telnyx::AI::ExternalLlm) -> Telnyx::AI::ExternalLlm

        attr_reader instructions: String?

        def instructions=: (String) -> String

        attr_reader llm_api_key_ref: String?

        def llm_api_key_ref=: (String) -> String

        attr_reader mode: Telnyx::Models::AI::DelegationSettings::mode?

        def mode=: (
          Telnyx::Models::AI::DelegationSettings::mode
        ) -> Telnyx::Models::AI::DelegationSettings::mode

        attr_reader model: String?

        def model=: (String) -> String

        attr_reader speak_results: bool?

        def speak_results=: (bool) -> bool

        def initialize: (
          ?enabled: bool,
          ?external_llm: Telnyx::AI::ExternalLlm,
          ?instructions: String,
          ?llm_api_key_ref: String,
          ?mode: Telnyx::Models::AI::DelegationSettings::mode,
          ?model: String,
          ?speak_results: bool
        ) -> void

        def to_hash: -> {
          enabled: bool,
          external_llm: Telnyx::AI::ExternalLlm,
          instructions: String,
          llm_api_key_ref: String,
          mode: Telnyx::Models::AI::DelegationSettings::mode,
          model: String,
          speak_results: bool
        }

        type mode = :telnyx | :client

        module Mode
          extend Telnyx::Internal::Type::Enum

          TELNYX: :telnyx
          CLIENT: :client

          def self?.values: -> ::Array[Telnyx::Models::AI::DelegationSettings::mode]
        end
      end
    end
  end
end
