          background_id: Telnyx::Models::AI::AvatarSettingsRequest::background_id,
          model: Telnyx::Models::AI::AvatarSettingsRequest::model,
          provider: :telnyx
        }

        type background_id = :office | :studio | :reception

        module BackgroundID
          extend Telnyx::Internal::Type::Enum

          OFFICE: :office
          STUDIO: :studio
          RECEPTION: :reception

          def self?.values: -> ::Array[Telnyx::Models::AI::AvatarSettingsRequest::background_id]
