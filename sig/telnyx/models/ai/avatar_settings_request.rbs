        }

      class AvatarSettingsRequest < Telnyx::Internal::Type::BaseModel
        attr_accessor avatar_id: Telnyx::Models::AI::avatar_id

        attr_accessor background_id: Telnyx::Models::AI::AvatarSettingsRequest::background_id

        attr_accessor model: Telnyx::Models::AI::AvatarSettingsRequest::model

        attr_accessor provider: :telnyx

        def initialize: (
          avatar_id: Telnyx::Models::AI::avatar_id,
          background_id: Telnyx::Models::AI::AvatarSettingsRequest::background_id,
          model: Telnyx::Models::AI::AvatarSettingsRequest::model,
          ?provider: :telnyx
