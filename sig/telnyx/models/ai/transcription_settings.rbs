module Telnyx
  module Models
    module AI
      type transcription_settings =
        {
          api_key_ref: String,
          challenger: Telnyx::AI::TranscriptionSettings::Challenger?,
          fallback_models: ::Array[Telnyx::AI::TranscriptionSettings::FallbackModel]?,
          language: String,
          model: Telnyx::Models::AI::TranscriptionSettings::model,
          region: String,
          settings: Telnyx::AI::TranscriptionSettingsConfig
        }

      class TranscriptionSettings < Telnyx::Internal::Type::BaseModel
        attr_reader api_key_ref: String?

        def api_key_ref=: (String) -> String

        attr_accessor challenger: Telnyx::AI::TranscriptionSettings::Challenger?

        attr_accessor fallback_models: ::Array[Telnyx::AI::TranscriptionSettings::FallbackModel]?

        attr_reader language: String?

        def language=: (String) -> String

        attr_reader model: Telnyx::Models::AI::TranscriptionSettings::model?

        def model=: (
          Telnyx::Models::AI::TranscriptionSettings::model
        ) -> Telnyx::Models::AI::TranscriptionSettings::model

        attr_reader region: String?

        def region=: (String) -> String

        attr_reader settings: Telnyx::AI::TranscriptionSettingsConfig?

        def settings=: (
          Telnyx::AI::TranscriptionSettingsConfig
        ) -> Telnyx::AI::TranscriptionSettingsConfig

        def initialize: (
          ?api_key_ref: String,
          ?challenger: Telnyx::AI::TranscriptionSettings::Challenger?,
          ?fallback_models: ::Array[Telnyx::AI::TranscriptionSettings::FallbackModel]?,
          ?language: String,
          ?model: Telnyx::Models::AI::TranscriptionSettings::model,
          ?region: String,
          ?settings: Telnyx::AI::TranscriptionSettingsConfig
        ) -> void

        def to_hash: -> {
          api_key_ref: String,
          challenger: Telnyx::AI::TranscriptionSettings::Challenger?,
          fallback_models: ::Array[Telnyx::AI::TranscriptionSettings::FallbackModel]?,
          language: String,
          model: Telnyx::Models::AI::TranscriptionSettings::model,
          region: String,
          settings: Telnyx::AI::TranscriptionSettingsConfig
        }

        type challenger =
          {
            model: Telnyx::Models::AI::TranscriptionSettings::Challenger::model,
            language: String?,
            rule: Telnyx::Models::AI::TranscriptionSettings::Challenger::rule,
            settings: Telnyx::AI::TranscriptionSettingsConfig?
          }

        class Challenger < Telnyx::Internal::Type::BaseModel
