module Telnyx
  module Models
    module AI
      type privacy_settings =
        { data_retention: bool, in_transit_data_locality: bool }

      class PrivacySettings < Telnyx::Internal::Type::BaseModel
        attr_reader data_retention: bool?

        def data_retention=: (bool) -> bool

        attr_reader in_transit_data_locality: bool?

        def in_transit_data_locality=: (bool) -> bool

        def initialize: (
          ?data_retention: bool,
          ?in_transit_data_locality: bool
        ) -> void

        def to_hash: -> { data_retention: bool, in_transit_data_locality: bool }
      end
    end
  end
end
