              attr_accessor namespace: String

              attr_accessor profile_id: String

              attr_accessor source_id: String

              def initialize: (
                namespace: String,
                profile_id: String,
                source_id: String,
                ?request_options: Telnyx::request_opts
              ) -> void

              def to_hash: -> {
                namespace: String,
                profile_id: String,
                source_id: String,
                request_options: Telnyx::RequestOptions
              }
            end
          end
        end
