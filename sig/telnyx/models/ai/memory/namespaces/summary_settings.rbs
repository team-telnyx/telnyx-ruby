module Telnyx
  module Models
    module AI
      module Memory
        module Namespaces
          type summary_settings = { instructions: String? }

          class SummarySettings < Telnyx::Internal::Type::BaseModel
            attr_accessor instructions: String?

            def initialize: (?instructions: String?) -> void

            def to_hash: -> { instructions: String? }
          end
        end
      end
    end
  end
end
