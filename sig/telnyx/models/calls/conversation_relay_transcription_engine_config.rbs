module Telnyx
  module Models
    module Calls
      type conversation_relay_transcription_engine_config =
        {
          eager_eot_threshold: Float,
          eot_threshold: Float,
          interim_results: bool
        }

      class ConversationRelayTranscriptionEngineConfig < Telnyx::Internal::Type::BaseModel
        attr_reader eager_eot_threshold: Float?

        def eager_eot_threshold=: (Float) -> Float

        attr_reader eot_threshold: Float?

        def eot_threshold=: (Float) -> Float

        attr_reader interim_results: bool?

        def interim_results=: (bool) -> bool

        def initialize: (
          ?eager_eot_threshold: Float,
          ?eot_threshold: Float,
          ?interim_results: bool
        ) -> void

        def to_hash: -> {
          eager_eot_threshold: Float,
          eot_threshold: Float,
          interim_results: bool
        }
      end
    end
  end
end
