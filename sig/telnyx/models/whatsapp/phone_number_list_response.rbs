module Telnyx
  module Models
    module Whatsapp
      type phone_number_list_response =
        {
          calling_enabled: bool,
          coexistence_state: Telnyx::Models::Whatsapp::PhoneNumberListResponse::coexistence_state?,
          created_at: Time,
          display_name: String,
          enabled: bool,
          is_on_biz_app: bool,
          phone_number: String,
          phone_number_id: String,
          quality_rating: String,
          record_type: String,
          status: String,
          sync_deadline: Time?,
          sync_progress: Telnyx::Models::Whatsapp::PhoneNumberListResponse::SyncProgress?,
          user_id: String,
          waba_id: String
        }

      class PhoneNumberListResponse < Telnyx::Internal::Type::BaseModel
        attr_reader calling_enabled: bool?

        def calling_enabled=: (bool) -> bool

        attr_accessor coexistence_state: Telnyx::Models::Whatsapp::PhoneNumberListResponse::coexistence_state?

        attr_reader created_at: Time?

        def created_at=: (Time) -> Time

        attr_reader display_name: String?

        def display_name=: (String) -> String

        attr_reader enabled: bool?

        def enabled=: (bool) -> bool

        attr_reader is_on_biz_app: bool?

        def is_on_biz_app=: (bool) -> bool

        attr_reader phone_number: String?

        def phone_number=: (String) -> String

        attr_reader phone_number_id: String?

        def phone_number_id=: (String) -> String

        attr_reader quality_rating: String?

        def quality_rating=: (String) -> String

        attr_reader record_type: String?

        def record_type=: (String) -> String

        attr_reader status: String?

        def status=: (String) -> String

        attr_accessor sync_deadline: Time?

        attr_accessor sync_progress: Telnyx::Models::Whatsapp::PhoneNumberListResponse::SyncProgress?

        attr_reader user_id: String?

        def user_id=: (String) -> String

        attr_reader waba_id: String?

        def waba_id=: (String) -> String

        def initialize: (
          ?calling_enabled: bool,
          ?coexistence_state: Telnyx::Models::Whatsapp::PhoneNumberListResponse::coexistence_state?,
          ?created_at: Time,
          ?display_name: String,
          ?enabled: bool,
          ?is_on_biz_app: bool,
          ?phone_number: String,
          ?phone_number_id: String,
          ?quality_rating: String,
          ?record_type: String,
          ?status: String,
          ?sync_deadline: Time?,
          ?sync_progress: Telnyx::Models::Whatsapp::PhoneNumberListResponse::SyncProgress?,
          ?user_id: String,
          ?waba_id: String
        ) -> void

        def to_hash: -> {
          calling_enabled: bool,
          coexistence_state: Telnyx::Models::Whatsapp::PhoneNumberListResponse::coexistence_state?,
          created_at: Time,
          display_name: String,
          enabled: bool,
          is_on_biz_app: bool,
          phone_number: String,
          phone_number_id: String,
          quality_rating: String,
          record_type: String,
          status: String,
          sync_deadline: Time?,
          sync_progress: Telnyx::Models::Whatsapp::PhoneNumberListResponse::SyncProgress?,
          user_id: String,
          waba_id: String
        }

        type coexistence_state =
          :pending_onboarding
          | :sync_pending
          | :syncing
          | :sync_complete
          | :active
          | :history_declined
          | :sync_deadline_expired
          | :offboarded
          | :disconnected

        module CoexistenceState
          extend Telnyx::Internal::Type::Enum

          PENDING_ONBOARDING: :pending_onboarding
          SYNC_PENDING: :sync_pending
          SYNCING: :syncing
          SYNC_COMPLETE: :sync_complete
          ACTIVE: :active
          HISTORY_DECLINED: :history_declined
          SYNC_DEADLINE_EXPIRED: :sync_deadline_expired
          OFFBOARDED: :offboarded
          DISCONNECTED: :disconnected

          def self?.values: -> ::Array[Telnyx::Models::Whatsapp::PhoneNumberListResponse::coexistence_state]
        end

        type sync_progress =
          {
            contacts_status: String,
            history_chunk_order: Integer?,
            history_phase: Integer?,
            history_progress: Integer?,
            history_status: String
          }

        class SyncProgress < Telnyx::Internal::Type::BaseModel
          attr_reader contacts_status: String?

          def contacts_status=: (String) -> String

          attr_accessor history_chunk_order: Integer?

          attr_accessor history_phase: Integer?

          attr_accessor history_progress: Integer?

          attr_reader history_status: String?

          def history_status=: (String) -> String

          def initialize: (
            ?contacts_status: String,
            ?history_chunk_order: Integer?,
            ?history_phase: Integer?,
            ?history_progress: Integer?,
            ?history_status: String
          ) -> void

          def to_hash: -> {
            contacts_status: String,
            history_chunk_order: Integer?,
            history_phase: Integer?,
            history_progress: Integer?,
            history_status: String
          }
        end
      end
    end
  end
end
