module Telnyx
  module Models
    module EmailMessages
      type recipient_retrieve_params =
        { email_id: String, recipient_id: String }
        & Telnyx::Internal::Type::request_parameters

      class RecipientRetrieveParams < Telnyx::Internal::Type::BaseModel
        extend Telnyx::Internal::Type::RequestParameters::Converter
        include Telnyx::Internal::Type::RequestParameters

        attr_accessor email_id: String

        attr_accessor recipient_id: String

        def initialize: (
          email_id: String,
          recipient_id: String,
          ?request_options: Telnyx::request_opts
        ) -> void

        def to_hash: -> {
          email_id: String,
          recipient_id: String,
          request_options: Telnyx::RequestOptions
        }
      end
    end
  end
end
