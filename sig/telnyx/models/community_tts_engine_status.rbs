module Telnyx
  module Models
    type community_tts_engine_status = :draft | :active | :disabled | :suspended

    module CommunityTtsEngineStatus
      extend Telnyx::Internal::Type::Enum

      DRAFT: :draft
      ACTIVE: :active
      DISABLED: :disabled
      SUSPENDED: :suspended

      def self?.values: -> ::Array[Telnyx::Models::community_tts_engine_status]
    end
  end
end
