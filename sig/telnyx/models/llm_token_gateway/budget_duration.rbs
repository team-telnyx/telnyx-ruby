module Telnyx
  module Models
    module LlmTokenGateway
      type budget_duration = :"1d" | :"7d" | :"30d"

      module BudgetDuration
        extend Telnyx::Internal::Type::Enum

        BUDGET_DURATION_1D: :"1d"
        BUDGET_DURATION_7D: :"7d"
        BUDGET_DURATION_30D: :"30d"

        def self?.values: -> ::Array[Telnyx::Models::LlmTokenGateway::budget_duration]
      end
    end
  end
end
