module Telnyx
  module Models
    module LlmTokenGateway
      type usage_retrieve_summary_params =
        { end_date: Date, start_date: Date, token_group_id: String }
        & Telnyx::Internal::Type::request_parameters

      class UsageRetrieveSummaryParams < Telnyx::Internal::Type::BaseModel
        extend Telnyx::Internal::Type::RequestParameters::Converter
        include Telnyx::Internal::Type::RequestParameters

        attr_accessor end_date: Date

        attr_accessor start_date: Date

        attr_accessor token_group_id: String

        def initialize: (
          end_date: Date,
          start_date: Date,
          token_group_id: String,
          ?request_options: Telnyx::request_opts
        ) -> void

        def to_hash: -> {
          end_date: Date,
          start_date: Date,
          token_group_id: String,
          request_options: Telnyx::RequestOptions
        }
      end
    end
  end
end
