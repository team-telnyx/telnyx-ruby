    class TtsIntegrationRetrieveVoicesResponse < Telnyx::Internal::Type::BaseModel
      attr_accessor voices: ::Array[Telnyx::Models::TtsIntegrationRetrieveVoicesResponse::Voice]

      def initialize: (
        voices: ::Array[Telnyx::Models::TtsIntegrationRetrieveVoicesResponse::Voice]
      ) -> void

      def to_hash: -> {
        voices: ::Array[Telnyx::Models::TtsIntegrationRetrieveVoicesResponse::Voice]
      }

      type voice =
        {
          voice_id: String,
          gender: String,
          language: String,
          name: String,
          provider: String
        }

      class Voice < Telnyx::Internal::Type::BaseModel
        attr_accessor voice_id: String

        attr_reader gender: String?

