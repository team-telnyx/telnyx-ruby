module Telnyx
  module Models
    module MeetingSessions
      type action_speak_params =
        { id: String, text: String, interrupt: bool, voice: String }
        & Telnyx::Internal::Type::request_parameters

      class ActionSpeakParams < Telnyx::Internal::Type::BaseModel
        extend Telnyx::Internal::Type::RequestParameters::Converter
        include Telnyx::Internal::Type::RequestParameters

        attr_accessor id: String

        attr_accessor text: String

        attr_reader interrupt: bool?

        def interrupt=: (bool) -> bool

        attr_reader voice: String?

        def voice=: (String) -> String

        def initialize: (
          id: String,
          text: String,
          ?interrupt: bool,
          ?voice: String,
          ?request_options: Telnyx::request_opts
        ) -> void

        def to_hash: -> {
          id: String,
          text: String,
          interrupt: bool,
          voice: String,
          request_options: Telnyx::RequestOptions
        }
      end
    end
  end
end
