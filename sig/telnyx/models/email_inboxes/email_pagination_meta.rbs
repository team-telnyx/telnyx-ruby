module Telnyx
  module Models
    module EmailInboxes
      type email_pagination_meta = { page_size: Integer, page_cursor: String }

      class EmailPaginationMeta < Telnyx::Internal::Type::BaseModel
        attr_accessor page_size: Integer

        attr_reader page_cursor: String?

        def page_cursor=: (String) -> String

        def initialize: (page_size: Integer, ?page_cursor: String) -> void

        def to_hash: -> { page_size: Integer, page_cursor: String }
      end
    end
  end
end
