module Telnyx
  module Models
    module EmailInboxes
      type draft_send_params =
        { inbox_id: String, draft_id: String }
        & Telnyx::Internal::Type::request_parameters

      class DraftSendParams < Telnyx::Internal::Type::BaseModel
        extend Telnyx::Internal::Type::RequestParameters::Converter
        include Telnyx::Internal::Type::RequestParameters

        attr_accessor inbox_id: String

        attr_accessor draft_id: String

        def initialize: (
          inbox_id: String,
          draft_id: String,
          ?request_options: Telnyx::request_opts
        ) -> void

        def to_hash: -> {
          inbox_id: String,
          draft_id: String,
          request_options: Telnyx::RequestOptions
        }
      end
    end
  end
end
