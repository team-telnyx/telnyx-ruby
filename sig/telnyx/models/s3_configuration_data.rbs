module Telnyx
  module Models
    type s3_configuration_data =
      {
        aws_access_key_id: String,
        aws_secret_access_key: String,
        backend: Telnyx::Models::S3ConfigurationData::backend,
        bucket: String,
        region: String
      }

    class S3ConfigurationData < Telnyx::Internal::Type::BaseModel
      attr_accessor aws_access_key_id: String

      attr_accessor aws_secret_access_key: String

      attr_accessor backend: Telnyx::Models::S3ConfigurationData::backend

      attr_accessor bucket: String

      attr_accessor region: String

      def initialize: (
        aws_access_key_id: String,
        aws_secret_access_key: String,
        backend: Telnyx::Models::S3ConfigurationData::backend,
        bucket: String,
        region: String
      ) -> void

      def to_hash: -> {
        aws_access_key_id: String,
        aws_secret_access_key: String,
        backend: Telnyx::Models::S3ConfigurationData::backend,
        bucket: String,
        region: String
      }

      type backend = :s3

      module Backend
        extend Telnyx::Internal::Type::Enum

        S3: :s3

        def self?.values: -> ::Array[Telnyx::Models::S3ConfigurationData::backend]
      end
    end
  end
end
