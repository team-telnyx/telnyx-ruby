module Telnyx
  module Models
    module Rcs
      type brand_response =
        {
          addresses: ::Hash[Symbol, Telnyx::Rcs::BrandResponse::Address],
          brand_id: String,
          capabilities: Telnyx::Rcs::CapabilitiesResponse,
          contacts: ::Hash[Symbol, Telnyx::Rcs::BrandContact],
          display_name: String,
          identifiers: ::Hash[Symbol, Telnyx::Models::Rcs::BrandResponse::identifier],
          legal_entity_type: String,
          legal_name: String,
          organization_type: String,
          profile_id: String?,
          status: Telnyx::Models::Rcs::BrandResponse::status,
          website_url: String
        }

      class BrandResponse < Telnyx::Internal::Type::BaseModel
        attr_accessor addresses: ::Hash[Symbol, Telnyx::Rcs::BrandResponse::Address]

        attr_accessor brand_id: String

        attr_accessor capabilities: Telnyx::Rcs::CapabilitiesResponse

        attr_accessor contacts: ::Hash[Symbol, Telnyx::Rcs::BrandContact]

        attr_accessor display_name: String

        attr_accessor identifiers: ::Hash[Symbol, Telnyx::Models::Rcs::BrandResponse::identifier]

        attr_accessor legal_entity_type: String

        attr_accessor legal_name: String

        attr_accessor organization_type: String

        attr_accessor profile_id: String?

        attr_accessor status: Telnyx::Models::Rcs::BrandResponse::status

        attr_accessor website_url: String

        def initialize: (
          addresses: ::Hash[Symbol, Telnyx::Rcs::BrandResponse::Address],
          brand_id: String,
          capabilities: Telnyx::Rcs::CapabilitiesResponse,
          contacts: ::Hash[Symbol, Telnyx::Rcs::BrandContact],
          display_name: String,
          identifiers: ::Hash[Symbol, Telnyx::Models::Rcs::BrandResponse::identifier],
          legal_entity_type: String,
          legal_name: String,
          organization_type: String,
          profile_id: String?,
          status: Telnyx::Models::Rcs::BrandResponse::status,
          website_url: String
        ) -> void

        def to_hash: -> {
          addresses: ::Hash[Symbol, Telnyx::Rcs::BrandResponse::Address],
          brand_id: String,
          capabilities: Telnyx::Rcs::CapabilitiesResponse,
          contacts: ::Hash[Symbol, Telnyx::Rcs::BrandContact],
          display_name: String,
          identifiers: ::Hash[Symbol, Telnyx::Models::Rcs::BrandResponse::identifier],
          legal_entity_type: String,
          legal_name: String,
          organization_type: String,
          profile_id: String?,
          status: Telnyx::Models::Rcs::BrandResponse::status,
          website_url: String
        }

        type address =
          {
            administrative_area: String,
            city: String,
            country_code: String,
            :line_1 => String,
            postal_code: String,
            :line_2 => String?
          }

        class Address < Telnyx::Internal::Type::BaseModel
          attr_accessor administrative_area: String

          attr_accessor city: String

          attr_accessor country_code: String

          attr_accessor line_1: String

          attr_accessor postal_code: String

          attr_accessor line_2: String?

          def initialize: (
            administrative_area: String,
            city: String,
            country_code: String,
            line_1: String,
            postal_code: String,
            ?line_2: String?
          ) -> void

          def to_hash: -> {
            administrative_area: String,
            city: String,
            country_code: String,
            :line_1 => String,
            postal_code: String,
            :line_2 => String?
          }
        end

        type identifier =
          Telnyx::Rcs::EinBrandIdentifier
          | Telnyx::Rcs::StockSymbolBrandIdentifier

        module Identifier
          extend Telnyx::Internal::Type::Union

          def self?.variants: -> ::Array[Telnyx::Models::Rcs::BrandResponse::identifier]
        end

        type status =
          :CREATED
          | :CONFIGURED
          | :SUBMITTED
          | :REVIEWING
          | :VETTING
          | :VERIFIED
          | :REJECTED
          | :FAILED

        module Status
          extend Telnyx::Internal::Type::Enum

          CREATED: :CREATED
          CONFIGURED: :CONFIGURED
          SUBMITTED: :SUBMITTED
          REVIEWING: :REVIEWING
          VETTING: :VETTING
          VERIFIED: :VERIFIED
          REJECTED: :REJECTED
          FAILED: :FAILED

          def self?.values: -> ::Array[Telnyx::Models::Rcs::BrandResponse::status]
        end
      end
    end
  end
end
