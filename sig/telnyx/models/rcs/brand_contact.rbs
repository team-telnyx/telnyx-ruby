module Telnyx
  module Models
    module Rcs
      type brand_contact =
        {
          contact_type: Telnyx::Models::Rcs::BrandContact::contact_type,
          email: String,
          first_name: String,
          last_name: String,
          phone_number: String,
          title: String?
        }

      class BrandContact < Telnyx::Internal::Type::BaseModel
        attr_accessor contact_type: Telnyx::Models::Rcs::BrandContact::contact_type

        attr_accessor email: String

        attr_accessor first_name: String

        attr_accessor last_name: String

        attr_accessor phone_number: String

        attr_accessor title: String?

        def initialize: (
          contact_type: Telnyx::Models::Rcs::BrandContact::contact_type,
          email: String,
          first_name: String,
          last_name: String,
          phone_number: String,
          ?title: String?
        ) -> void

        def to_hash: -> {
          contact_type: Telnyx::Models::Rcs::BrandContact::contact_type,
          email: String,
          first_name: String,
          last_name: String,
          phone_number: String,
          title: String?
        }

        type contact_type =
          :BRAND
          | :PRIMARY
          | :OFFICER
          | :AGENT
          | :RESPONSIBLE_PARTY
          | :BILLING
          | :UNKNOWN

        module ContactType
          extend Telnyx::Internal::Type::Enum

          BRAND: :BRAND
          PRIMARY: :PRIMARY
          OFFICER: :OFFICER
          AGENT: :AGENT
          RESPONSIBLE_PARTY: :RESPONSIBLE_PARTY
          BILLING: :BILLING
          UNKNOWN: :UNKNOWN

          def self?.values: -> ::Array[Telnyx::Models::Rcs::BrandContact::contact_type]
        end
      end
    end
  end
end
