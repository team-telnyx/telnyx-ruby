module Telnyx
  module Models
    type meeting_session =
      {
        id: String,
        account_id: String,
        assistant: Telnyx::MeetingSessionAssistant?,
        assistant_state: Telnyx::Models::MeetingSession::assistant_state?,
        assistant_state_changed_at: Time?,
        avatar: Telnyx::MeetingSession::Avatar?,
        avatar_state: Telnyx::Models::MeetingSession::avatar_state?,
        avatar_state_changed_at: Time?,
        bot_name: String,
        config: Telnyx::MeetingSession::Config,
        created_at: Time,
        ended_at: Time?,
        failure_reason: String?,
        join_at: Time?,
        joined_at: Time?,
        meeting_url: String,
        metadata: ::Hash[Symbol, top],
        platform: Telnyx::Models::MeetingSession::platform,
        provider: :telnyx,
        recording: bool,
        status: Telnyx::Models::MeetingSession::status,
        status_detail: String?,
        updated_at: Time,
        webhook_url: String?,
        recording_export: Telnyx::MeetingSessionRecordingExport?,
        remote_state_observed_at: Time
      }

    class MeetingSession < Telnyx::Internal::Type::BaseModel
      attr_accessor id: String

      attr_accessor account_id: String

      attr_accessor assistant: Telnyx::MeetingSessionAssistant?

      attr_accessor assistant_state: Telnyx::Models::MeetingSession::assistant_state?

      attr_accessor assistant_state_changed_at: Time?

      attr_accessor avatar: Telnyx::MeetingSession::Avatar?

      attr_accessor avatar_state: Telnyx::Models::MeetingSession::avatar_state?

      attr_accessor avatar_state_changed_at: Time?

      attr_accessor bot_name: String

      attr_accessor config: Telnyx::MeetingSession::Config

      attr_accessor created_at: Time

      attr_accessor ended_at: Time?

      attr_accessor failure_reason: String?

      attr_accessor join_at: Time?

      attr_accessor joined_at: Time?

      attr_accessor meeting_url: String

      attr_accessor metadata: ::Hash[Symbol, top]

      attr_accessor platform: Telnyx::Models::MeetingSession::platform

      attr_accessor provider: :telnyx

      attr_accessor recording: bool

      attr_accessor status: Telnyx::Models::MeetingSession::status

      attr_accessor status_detail: String?

      attr_accessor updated_at: Time

      attr_accessor webhook_url: String?

      attr_accessor recording_export: Telnyx::MeetingSessionRecordingExport?

      attr_reader remote_state_observed_at: Time?

      def remote_state_observed_at=: (Time) -> Time

      def initialize: (
        id: String,
        account_id: String,
        assistant: Telnyx::MeetingSessionAssistant?,
        assistant_state: Telnyx::Models::MeetingSession::assistant_state?,
        assistant_state_changed_at: Time?,
        avatar: Telnyx::MeetingSession::Avatar?,
        avatar_state: Telnyx::Models::MeetingSession::avatar_state?,
        avatar_state_changed_at: Time?,
        bot_name: String,
        config: Telnyx::MeetingSession::Config,
        created_at: Time,
        ended_at: Time?,
        failure_reason: String?,
        join_at: Time?,
        joined_at: Time?,
        meeting_url: String,
        metadata: ::Hash[Symbol, top],
        platform: Telnyx::Models::MeetingSession::platform,
        recording: bool,
        status: Telnyx::Models::MeetingSession::status,
        status_detail: String?,
        updated_at: Time,
        webhook_url: String?,
        ?recording_export: Telnyx::MeetingSessionRecordingExport?,
        ?remote_state_observed_at: Time,
        ?provider: :telnyx
      ) -> void

      def to_hash: -> {
        id: String,
        account_id: String,
        assistant: Telnyx::MeetingSessionAssistant?,
        assistant_state: Telnyx::Models::MeetingSession::assistant_state?,
        assistant_state_changed_at: Time?,
        avatar: Telnyx::MeetingSession::Avatar?,
        avatar_state: Telnyx::Models::MeetingSession::avatar_state?,
        avatar_state_changed_at: Time?,
        bot_name: String,
        config: Telnyx::MeetingSession::Config,
        created_at: Time,
        ended_at: Time?,
        failure_reason: String?,
        join_at: Time?,
        joined_at: Time?,
        meeting_url: String,
        metadata: ::Hash[Symbol, top],
        platform: Telnyx::Models::MeetingSession::platform,
        provider: :telnyx,
        recording: bool,
        status: Telnyx::Models::MeetingSession::status,
        status_detail: String?,
        updated_at: Time,
        webhook_url: String?,
        recording_export: Telnyx::MeetingSessionRecordingExport?,
        remote_state_observed_at: Time
      }

      type assistant_state = :starting | :connected | :failed | :ended

      module AssistantState
        extend Telnyx::Internal::Type::Enum

        STARTING: :starting
        CONNECTED: :connected
        FAILED: :failed
        ENDED: :ended

        def self?.values: -> ::Array[Telnyx::Models::MeetingSession::assistant_state]
      end

      type avatar =
        {
          avatar_id: String,
          background_id: String,
          model: String,
          provider: :telnyx
        }

      class Avatar < Telnyx::Internal::Type::BaseModel
        attr_accessor avatar_id: String

        attr_accessor background_id: String

        attr_accessor model: String

        attr_accessor provider: :telnyx

        def initialize: (
          avatar_id: String,
          background_id: String,
          model: String,
          ?provider: :telnyx
        ) -> void

        def to_hash: -> {
          avatar_id: String,
          background_id: String,
          model: String,
          provider: :telnyx
        }
      end

      type avatar_state = :starting | :connected | :degraded | :disconnected

      module AvatarState
        extend Telnyx::Internal::Type::Enum

        STARTING: :starting
        CONNECTED: :connected
        DEGRADED: :degraded
        DISCONNECTED: :disconnected

        def self?.values: -> ::Array[Telnyx::Models::MeetingSession::avatar_state]
      end

      type config =
        {
          barge_in: bool,
          chat_on_enter: String?,
          deepfake_detection: Telnyx::MeetingSession::Config::DeepfakeDetection,
          speak_on_enter: String?,
          summarize_on_end: bool,
          voice: String?,
          leave_policy: Telnyx::MeetingSessionLeavePolicy,
          recording: bool,
          recording_view: Telnyx::Models::MeetingSession::Config::recording_view
        }

      class Config < Telnyx::Internal::Type::BaseModel
        attr_accessor barge_in: bool

        attr_accessor chat_on_enter: String?

        attr_accessor deepfake_detection: Telnyx::MeetingSession::Config::DeepfakeDetection

        attr_accessor speak_on_enter: String?

        attr_accessor summarize_on_end: bool

        attr_accessor voice: String?

        attr_reader leave_policy: Telnyx::MeetingSessionLeavePolicy?

        def leave_policy=: (
          Telnyx::MeetingSessionLeavePolicy
        ) -> Telnyx::MeetingSessionLeavePolicy

        attr_reader recording: bool?

        def recording=: (bool) -> bool

        attr_reader recording_view: Telnyx::Models::MeetingSession::Config::recording_view?

        def recording_view=: (
          Telnyx::Models::MeetingSession::Config::recording_view
        ) -> Telnyx::Models::MeetingSession::Config::recording_view

        def initialize: (
          barge_in: bool,
          chat_on_enter: String?,
          deepfake_detection: Telnyx::MeetingSession::Config::DeepfakeDetection,
          speak_on_enter: String?,
          summarize_on_end: bool,
          voice: String?,
          ?leave_policy: Telnyx::MeetingSessionLeavePolicy,
          ?recording: bool,
          ?recording_view: Telnyx::Models::MeetingSession::Config::recording_view
        ) -> void

        def to_hash: -> {
          barge_in: bool,
          chat_on_enter: String?,
          deepfake_detection: Telnyx::MeetingSession::Config::DeepfakeDetection,
          speak_on_enter: String?,
          summarize_on_end: bool,
          voice: String?,
          leave_policy: Telnyx::MeetingSessionLeavePolicy,
          recording: bool,
          recording_view: Telnyx::Models::MeetingSession::Config::recording_view
        }

        type deepfake_detection = { audio: bool, video: bool }

        class DeepfakeDetection < Telnyx::Internal::Type::BaseModel
          attr_accessor audio: bool

          attr_accessor video: bool

          def initialize: (audio: bool, video: bool) -> void

          def to_hash: -> { audio: bool, video: bool }
        end

        type recording_view = :gallery_view | :speaker_view_no_sidebar

        module RecordingView
          extend Telnyx::Internal::Type::Enum

          GALLERY_VIEW: :gallery_view
          SPEAKER_VIEW_NO_SIDEBAR: :speaker_view_no_sidebar

          def self?.values: -> ::Array[Telnyx::Models::MeetingSession::Config::recording_view]
        end
      end

      type platform = :zoom | :google_meet | :teams | :webex | :unknown

      module Platform
        extend Telnyx::Internal::Type::Enum

        ZOOM: :zoom
        GOOGLE_MEET: :google_meet
        TEAMS: :teams
        WEBEX: :webex
        UNKNOWN: :unknown

        def self?.values: -> ::Array[Telnyx::Models::MeetingSession::platform]
      end

      type status =
        :scheduled
        | :joining
        | :waiting_for_admission
        | :active
        | :leaving
        | :ended
        | :failed
        | :admission_denied

      module Status
        extend Telnyx::Internal::Type::Enum

        SCHEDULED: :scheduled
        JOINING: :joining
        WAITING_FOR_ADMISSION: :waiting_for_admission
        ACTIVE: :active
        LEAVING: :leaving
        ENDED: :ended
        FAILED: :failed
        ADMISSION_DENIED: :admission_denied

        def self?.values: -> ::Array[Telnyx::Models::MeetingSession::status]
      end
    end
  end
end
