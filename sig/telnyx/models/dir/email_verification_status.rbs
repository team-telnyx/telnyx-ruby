        }

        type record_type = :email_verification

        module RecordType
          extend Telnyx::Internal::Type::Enum

          EMAIL_VERIFICATION: :email_verification

          def self?.values: -> ::Array[Telnyx::Models::Dir::EmailVerificationStatus::record_type]
