          status: Telnyx::Models::Dir::EmailVerificationStatus::status,
          expires_at: Time?,
          sends_remaining_today: Integer?
        }

      class EmailVerificationStatus < Telnyx::Internal::Type::BaseModel
        attr_accessor email_verified: bool

        attr_accessor status: Telnyx::Models::Dir::EmailVerificationStatus::status

        attr_accessor record_type: Telnyx::Models::Dir::EmailVerificationStatus::record_type

        attr_accessor expires_at: Time?

        attr_accessor sends_remaining_today: Integer?

        def initialize: (
          email_verified: bool,
          record_type: Telnyx::Models::Dir::EmailVerificationStatus::record_type,
          status: Telnyx::Models::Dir::EmailVerificationStatus::status,
          ?expires_at: Time?,
          ?sends_remaining_today: Integer?
        ) -> void

        def to_hash: -> {
