module Telnyx
  module Models
    type meeting_session_update_params =
      { id: String, bot_name: String, join_at: Time }
      & Telnyx::Internal::Type::request_parameters

    class MeetingSessionUpdateParams < Telnyx::Internal::Type::BaseModel
      extend Telnyx::Internal::Type::RequestParameters::Converter
      include Telnyx::Internal::Type::RequestParameters

      attr_accessor id: String

      attr_reader bot_name: String?

      def bot_name=: (String) -> String

      attr_reader join_at: Time?

      def join_at=: (Time) -> Time

      def initialize: (
        id: String,
        ?bot_name: String,
        ?join_at: Time,
        ?request_options: Telnyx::request_opts
      ) -> void

      def to_hash: -> {
        id: String,
        bot_name: String,
        join_at: Time,
        request_options: Telnyx::RequestOptions
      }
    end
  end
end
